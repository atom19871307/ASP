@page "/power"

<h3>Power Calculator</h3>

<div class="form-group">
    <label>Base (հիմք):</label>
    <input type="number" @bind="baseNumber" @bind:event="oninput" class="form-control" />
</div>

<div class="form-group">
    <label>Exponent (աստիճան):</label>
    <input type="number" @bind="exponent" @bind:event="oninput" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="CalculatePower">Calculate</button>

@if (result.HasValue)
{
    <div class="alert alert-success mt-3">
        <strong>@baseNumber</strong> ^ <strong>@exponent</strong> = <strong>@result</strong>
    </div>
}

@code {
    private double baseNumber = 2;
    private double exponent = 3;
    private double? result;

    private async Task CalculatePower()
    {
        // ՈՉԻՆՉ ՉԻ ԱՐԵՔ Task.Yield()-ի հետ: Ուղղակի հաշվարկեք:
        result = Math.Pow(baseNumber, exponent);

        // Սա կստիպի Blazor-ին թարմացնել էկրանը:
        await InvokeAsync(StateHasChanged);
    }
}