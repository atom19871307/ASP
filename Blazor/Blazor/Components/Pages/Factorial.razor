@page "/factorial"
@rendermode InteractiveServer

<h3>Factorial</h3>

<input type="number" @bind="n" />
<button @onclick="Calculate">Calculate</button>

<p>Factoral of @n is @f</p>

@* @code 
{
    private int n = 5;
    private int f = 1;

    private void Calculate()
    {
        f = 1;
        for (int i = 1; i <= n; i++)
        {
            f *= i;
        }
    }
} *@