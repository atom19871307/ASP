@page "/students/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademyContext> DbFactory

<PageTitle>Детали студента</PageTitle>

<h1>Детали студента</h1>

@if (student is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="card shadow-sm border-0" style="max-width: 600px;">
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">ID:</dt>
                <dd class="col-sm-8">@student.StudentId</dd>

                <dt class="col-sm-4">Фамилия:</dt>
                <dd class="col-sm-8">@student.LastName</dd>

                <dt class="col-sm-4">Имя:</dt>
                <dd class="col-sm-8">@student.FirstName</dd>

                <dt class="col-sm-4">Отчество:</dt>
                <dd class="col-sm-8">@student.MiddleName</dd>

                <dt class="col-sm-4">Дата рождения:</dt>
                <dd class="col-sm-8">@student.BirthDate</dd>

                <dt class="col-sm-4">Email:</dt>
                <dd class="col-sm-8">@student.Email</dd>

                <dt class="col-sm-4">Телефон:</dt>
                <dd class="col-sm-8">@student.Phone</dd>

                <dt class="col-sm-4">Группа:</dt>
                <dd class="col-sm-8">@student.Group?.GroupName</dd>
            </dl>

            <div class="d-flex gap-2 mt-4">
                <a href="/students/edit?id=@student.StudentId" class="btn btn-warning px-4">✏️ Редактировать</a>
                <a href="/students" class="btn btn-secondary px-4">↩️ Назад</a>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Student? student;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        student = await context.Students
            .Include(s => s.Group)
            .FirstOrDefaultAsync(s => s.StudentId == Id);
    }
}