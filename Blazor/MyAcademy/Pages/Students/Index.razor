@page "/students"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademyContext> DbFactory

<PageTitle>Студенты</PageTitle>

<h1>Студенты</h1>

<p>
    <a href="/students/create" class="btn btn-primary">➕ Добавить студента</a>
</p>

@if (students == null)
{
    <p><em>Загрузка...</em></p>
}
else if (students.Count == 0)
{
    <p>Студенты не найдены.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
                <th>Дата рождения</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Группа</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in students)
            {
                <tr>
                    <td>@student.StudentId</td>
                    <td>@student.LastName</td>
                    <td>@student.FirstName</td>
                    <td>@student.MiddleName</td>
                    <td>@student.BirthDate</td>
                    <td>@student.Email</td>
                    <td>@student.Phone</td>
                    <td>@student.Group?.GroupName</td>
                    <td>
                        <a href="/students/details?id=@student.StudentId">Details</a> |
                        <a href="/students/edit?id=@student.StudentId">Edit</a> |
                        <a href="/students/delete?id=@student.StudentId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Student>? students;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        students = await context.Students
            .Include(s => s.Group)
            .ToListAsync();
    }
}