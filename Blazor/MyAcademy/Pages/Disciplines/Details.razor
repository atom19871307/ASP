@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using MyAcademy.Models
@inject IDbContextFactory<MyAcademyContext> DbFactory

<PageTitle>Детали дисциплины</PageTitle>

<h1>Детали дисциплины</h1>

@if (discipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="card shadow-sm border-0" style="max-width: 500px;">
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-3">ID:</dt>
                <dd class="col-sm-9">@discipline.DisciplineId</dd>

                <dt class="col-sm-3">Название:</dt>
                <dd class="col-sm-9">@discipline.DisciplineName</dd>

                <dt class="col-sm-3">Кол-во занятий:</dt>
                <dd class="col-sm-9">@discipline.NumberOfLessons</dd>
            </dl>

            <div class="d-flex gap-2 mt-4">
                <a href="/disciplines/edit?id=@discipline.DisciplineId" class="btn btn-warning px-4">✏️ Редактировать</a>
                <a href="/disciplines" class="btn btn-secondary px-4">↩️ Назад</a>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private Discipline? discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.FindAsync((short)Id);
    }
}