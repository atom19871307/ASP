@page "/disciplines/create"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<h1>Создать дисциплину</h1>

<div class="card shadow-sm border-0" style="max-width: 500px;">
    <div class="card-body p-4">
        <EditForm method="post" Model="discipline" OnValidSubmit="AddDiscipline" FormName="create-discipline" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-3">
                <label for="name" class="form-label fw-bold">Название:</label>
                <InputText id="name" @bind-Value="discipline.discipline_name" class="form-control" />
                <ValidationMessage For="() => discipline.discipline_name" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="lessons" class="form-label fw-bold">Количество занятий:</label>
                <InputNumber id="lessons" @bind-Value="discipline.number_of_lessons" class="form-control" />
                <ValidationMessage For="() => discipline.number_of_lessons" class="text-danger" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                <a href="/disciplines" class="btn btn-secondary">❌ Отмена</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private Discipline discipline = new();

    private async Task AddDiscipline()
    {
        using var context = DbFactory.CreateDbContext();
        context.Disciplines.Add(discipline);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");
    }
}