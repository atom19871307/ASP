@page "/disciplines"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory

<h1>Дисциплины</h1>

<p>
    <a href="/disciplines/create" class="btn btn-primary">➕ Добавить дисциплину</a>
</p>

@if (disciplines == null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Кол-во занятий</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in disciplines)
            {
                <tr>
                    <td>@d.discipline_id</td>
                    <td>@d.discipline_name</td>
                    <td>@d.number_of_lessons</td>
                    <td>
                        <a href="/disciplines/details?id=@d.discipline_id">Details</a> |
                        <a href="/disciplines/edit?id=@d.discipline_id">Edit</a> |
                        <a href="/disciplines/delete?id=@d.discipline_id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Discipline>? disciplines;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        disciplines = await context.Disciplines.ToListAsync();
    }
}