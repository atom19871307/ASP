@page "/disciplines/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<h1>Редактировать дисциплину</h1>

@if (discipline is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <div class="card shadow-sm border-0" style="max-width: 500px;">
        <div class="card-body p-4">
            <EditForm method="post" Model="discipline" OnValidSubmit="UpdateDiscipline" FormName="edit-discipline" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="mb-3">
                    <label class="form-label fw-bold">ID:</label>
                    <input type="text" class="form-control" value="@discipline.discipline_id" disabled />
                </div>

                <div class="mb-3">
                    <label for="name" class="form-label fw-bold">Название:</label>
                    <InputText id="name" @bind-Value="discipline.discipline_name" class="form-control" />
                    <ValidationMessage For="() => discipline.discipline_name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="lessons" class="form-label fw-bold">Количество занятий:</label>
                    <InputNumber id="lessons" @bind-Value="discipline.number_of_lessons" class="form-control" />
                    <ValidationMessage For="() => discipline.number_of_lessons" class="text-danger" />
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                    <a href="/disciplines" class="btn btn-secondary">❌ Отмена</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private short id { get; set; }

    private Discipline? discipline;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        discipline = await context.Disciplines.FindAsync(id);
        if (discipline is null) NavigationManager.NavigateTo("/disciplines");
    }

    private async Task UpdateDiscipline()
    {
        if (discipline is null) return;

        using var context = DbFactory.CreateDbContext();
        var disciplineFromDb = await context.Disciplines.FindAsync(discipline.discipline_id);
        if (disciplineFromDb is null) return;

        disciplineFromDb.discipline_name = discipline.discipline_name;
        disciplineFromDb.number_of_lessons = discipline.number_of_lessons;

        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/disciplines");
    }
}