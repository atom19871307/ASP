@page "/students"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy.Models
@using Academy
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory

<PageTitle>Студенты</PageTitle>

<div class="controls">
    <h1>Студенты</h1>

    <p>
        <a href="students/create" class="btn btn-primary">Добавить</a>
    </p>

    @* ✅ Էջի չափի ընտրություն *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <label class="me-2">Показывать по:</label>
            <select class="form-select d-inline-block w-auto" @bind="itemsPerPage" @bind:after="OnPageSizeChanged">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
            <span class="ms-2">студентов на странице</span>
        </div>
        <div>
            <label class="me-2">Поиск:</label>
            <input type="text" class="form-control d-inline-block w-auto"
                   @bind="searchText" @bind:after="OnSearchChanged"
                   placeholder="Введите имя..." />
        </div>
    </div>
</div>

@* ✅ QuickGrid՝ Pagination, Sorting, Filter *@
<QuickGrid Class="table" Items="FilteredStudents" Pagination="pagination">
    <TemplateColumn Context="student"
                    Title="Student"
                    Sortable="true"
                    SortBy="sortBy">
        <a href="@($"students/details?stud_id={student.stud_id}")">@student.FullName</a>
    </TemplateColumn>

    <PropertyColumn Property="student => student.birth_date" Sortable="true" />

    <TemplateColumn Context="student"
                    Title="Age"
                    Sortable="true"
                    SortBy="GridSort<Student>.ByDescending(s => s.birth_date)">
        @student.Age
    </TemplateColumn>

    <PropertyColumn Property="student => student.Group.group_name" Sortable="true" />
    <PropertyColumn Property="student => student.Group.Direction.direction_name" Sortable="true" />
</QuickGrid>

@* ✅ Paginator *@
<Paginator State="pagination" />

@code
{
    private AcademyContext context = default!;
    IQueryable<Student> students = default!;
    GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name);

    // ✅ Pagination
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private int itemsPerPage = 10;
    private string searchText = "";

    [SupplyParameterFromQuery]
    string? Filter { get; set; }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        students = context.Students.Include(s => s.Group);
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    IQueryable<Student> FilteredStudents =>
        context.Students
            .Include(s => s.Group)
            .ThenInclude(g => g.Direction)
            .Where(s => string.IsNullOrEmpty(searchText)
                        || s.FullName.Contains(searchText));

    private void OnPageSizeChanged()
    {
        pagination.ItemsPerPage = itemsPerPage;
    }

    private async Task OnSearchChanged()
    {
        await Task.CompletedTask;
    }
}